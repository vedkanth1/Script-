 -- NPC Auto Farm System
-- For your own Roblox game

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local NPC_FOLDER = workspace:WaitForChild("NPCs")

local ATTACK_RANGE = 12
local TARGET_RANGE = 250
local ATTACK_COOLDOWN = 0.35
local MOVE_DISTANCE = 8

local playerData = {}

local function getCharacter(player)
	return player.Character
end

local function getRoot(character)
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(character)
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function isAlive(model)
	local humanoid = getHumanoid(model)
	return humanoid and humanoid.Health > 0
end

local function getNearestNPC(player)
	local character = getCharacter(player)
	local root = getRoot(character)

	if not root then
		return nil
	end

	local closest = nil
	local closestDistance = TARGET_RANGE

	for _, npc in ipairs(NPC_FOLDER:GetChildren()) do
		local npcRoot = getRoot(npc)

		if npcRoot and isAlive(npc) then
			local distance = (root.Position - npcRoot.Position).Magnitude

			if distance < closestDistance then
				closest = npc
				closestDistance = distance
			end
		end
	end

	return closest
end

local function attackNPC(player, npc)
	local character = getCharacter(player)
	local root = getRoot(character)

	if not root or not npc then
		return
	end

	local npcRoot = getRoot(npc)
	local npcHumanoid = getHumanoid(npc)

	if not npcRoot or not npcHumanoid or npcHumanoid.Health <= 0 then
		return
	end

	local distance = (root.Position - npcRoot.Position).Magnitude

	if distance <= ATTACK_RANGE then
		-- Replace this with your game's actual combat system.
		npcHumanoid:TakeDamage(10)
	end
end

local function moveToNPC(player, npc)
	local character = getCharacter(player)
	local humanoid = getHumanoid(character)
	local root = getRoot(character)
	local npcRoot = getRoot(npc)

	if not humanoid or not root or not npcRoot then
		return
	end

	local direction = (root.Position - npcRoot.Position)

	if direction.Magnitude < 0.1 then
		direction = Vector3.new(0, 0, 1)
	end

	direction = direction.Unit

	local destination =
		npcRoot.Position
		+ direction * MOVE_DISTANCE

	humanoid:MoveTo(destination)
end

Players.PlayerAdded:Connect(function(player)
	playerData[player] = {
		Enabled = false,
		LastAttack = 0,
		Target = nil
	}
end)

Players.PlayerRemoving:Connect(function(player)
	playerData[player] = nil
end)

RunService.Heartbeat:Connect(function()
	for player, data in pairs(playerData) do
		if not data.Enabled then
			continue
		end

		local character = getCharacter(player)
		local humanoid = getHumanoid(character)

		if not character or not humanoid or humanoid.Health <= 0 then
			data.Target = nil
			continue
		end

		-- Find a new target.
		if not data.Target or not isAlive(data.Target) then
			data.Target = getNearestNPC(player)
		end

		local target = data.Target

		if not target then
			continue
		end

		local root = getRoot(character)
		local targetRoot = getRoot(target)

		if not root or not targetRoot then
			data.Target = nil
			continue
		end

		local distance = (root.Position - targetRoot.Position).Magnitude

		-- Target moved too far away.
		if distance > TARGET_RANGE then
			data.Target = nil
			continue
		end

		if distance > ATTACK_RANGE then
			moveToNPC(player, target)
		else
			humanoid:MoveTo(root.Position)

			if os.clock() - data.LastAttack >= ATTACK_COOLDOWN then
				data.LastAttack = os.clock()
				attackNPC(player, target)
			end
		end
	end
end)

